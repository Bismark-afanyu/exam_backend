PROJECT_NAME="FastAPI Firestore Backend"
API_V1_STR="/api/v1"

# Firebase Credentials
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email@your-project.iam.gserviceaccount.com"
# For the private key, replace newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional
# FIREBASE_SERVICE_ACCOUNT_PATH="./service-account.json"

# CORS Origins (comma-separated, leave blank for localhost defaults)
# BACKEND_CORS_ORIGINS="https://your-frontend.com"

# AI Configuration
GEMINI_API_KEY="your-gemini-api-key"
# HF_TOKEN="your-huggingface-token"

# Auth
# Secret key used to sign JWT tokens. Use a long random value in production.
SECRET_KEY="change-me-to-a-long-random-string"
# Token lifetime in minutes (default 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
